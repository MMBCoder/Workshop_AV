# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
# The notebooks load it automatically via python-dotenv (load_dotenv()).
# NEVER commit your real .env — it's gitignored.

# --- required ---
OPENAI_API_KEY=sk-...

# --- web search ---
TAVILY_API_KEY=tvly-...     # used in Module 2
SELTZ_API_KEY=sk_...        # used in later modules

# --- optional: tracing / evaluation (module 9) ---
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=agentic-ai-workshop
